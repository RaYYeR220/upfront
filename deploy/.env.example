# Public host for the API (Caddy gets a certificate for it)
API_HOST=api.example.com

# SERV Reasoning (console.openserv.ai)
SERV_API_KEY=
# Reppo Evaluation API (eval.reppo.xyz); leave empty to skip independent review
REPPO_API_KEY=
# Receiving address for paid checks (USDC on Base)
X402_PAY_TO=

# Abuse limits for the free demo
IP_SALT=change-me
CHECKS_PER_IP_PER_DAY=3
HOUSE_DAILY_CAP_USD=5
MAX_ACTIVE_WATCHES=300
MAX_WATCHES_PER_IP=5
ADMIN_TOKEN=

# Web app origin (CORS and links in alerts)
PUBLIC_WEB_URL=https://upfront.example.com
CORS_ORIGINS=https://upfront.example.com

# Telegram alerts for the watchlist
UPFRONT_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Example companies shown in the public feed (comma-separated SIRENs)
EXAMPLE_SIRENS=552032534,841936560
